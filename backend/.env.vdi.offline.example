# CPU-only, credential-free VDI profile for installation checks and demos.
# It uses deterministic hash embeddings and extractive answers; use the gateway
# profile for production-quality semantic retrieval and LLM generation.
RAG_DEVICE=cpu
RAG_DATA_DIR=./data
RAG_INDEX_VERSION=vdi-offline-1
RAG_EMBEDDER_BACKEND=hash
RAG_VECTORSTORE_BACKEND=chroma
RAG_RERANKER_BACKEND=lexical
RAG_LLM_PROVIDER=extractive
RAG_CACHE_BACKEND=memory
RAG_MEMORY_BACKEND=sqlite
RAG_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
