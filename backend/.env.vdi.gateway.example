# CPU-only VDI profile using an OpenAI-compatible enterprise gateway.
# Fill the three values below before starting the backend. Do not commit this file.
RAG_DEVICE=cpu
RAG_DATA_DIR=./data
RAG_INDEX_VERSION=vdi-gateway-1

# No local torch, sentence-transformer, or Hugging Face model downloads.
RAG_EMBEDDER_BACKEND=openai
RAG_EMBEDDING_API_BASE_URL=https://YOUR-AIPORTAL-HOST/v1
RAG_EMBEDDING_API_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIM=1536
RAG_EMBEDDING_API_KEY_ENV=OPENAI_API_KEY
RAG_VECTORSTORE_BACKEND=chroma
RAG_RERANKER_BACKEND=lexical

RAG_LLM_PROVIDER=openai
RAG_LLM_BASE_URL=https://YOUR-AIPORTAL-HOST/v1
RAG_LLM_MODEL=gpt-4o-mini
RAG_LLM_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=REPLACE_WITH_YOUR_GATEWAY_KEY

RAG_CACHE_BACKEND=memory
RAG_MEMORY_BACKEND=sqlite
RAG_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
