# FPT RAG — environment configuration (copy to .env and adjust).
# Every value has a sensible default in rag/config.py; set only what you need.

# ============================================================================
# QUICK PROFILES
# ============================================================================
# Offline dev (no models, no LLM key — used by the CLIs' --offline flag):
#   RAG_EMBEDDER_BACKEND=hash
#   RAG_VECTORSTORE_BACKEND=chroma
#   RAG_RERANKER_BACKEND=lexical
#   RAG_LLM_PROVIDER=extractive
#
# Company VDI without model downloads (drive everything through aiportalapi):
#   RAG_EMBEDDER_BACKEND=openai
#   RAG_EMBEDDING_API_BASE_URL=https://<aiportalapi-host>/v1
#   RAG_EMBEDDING_DIM=1536
#   RAG_LLM_PROVIDER=openai
#   RAG_LLM_BASE_URL=https://<aiportalapi-host>/v1
#   RAG_LLM_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=<your aiportalapi key>
#
# Local demo with NO API key (uses the machine's `claude` CLI login):
#   RAG_EMBEDDER_BACKEND=hash        # or chroma-backed for a persistent index
#   RAG_VECTORSTORE_BACKEND=chroma
#   RAG_RERANKER_BACKEND=lexical
#   RAG_LLM_PROVIDER=claude_cli
#   RAG_LLM_MODEL=claude-haiku-4-5-20251001
#   RAG_CLAUDE_CLI_BIN=<abs path to claude.exe>   # if `claude` isn't a plain exe on PATH
#
# For a Gemini demo, use the openai provider against Gemini's OpenAI-compatible
# endpoint (there is no native gemini provider):
#   RAG_LLM_PROVIDER=openai
#   RAG_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   RAG_LLM_MODEL=gemini-2.5-flash
#   OPENAI_API_KEY=<your Google AI Studio key>

# ============================================================================
# STORAGE
# ============================================================================
RAG_DATA_DIR=./data                 # chroma/, bm25/, audit/, quarantine/, manifest
RAG_INDEX_VERSION=index-1

# Original uploads are stored privately below RAG_DATA_DIR/originals and served
# only through the API's document ACL check.

# Local OCR (default) handles scanned PDFs and image files. The Tesseract binary
# must be installed on the host; Docker installs English + Vietnamese data.
RAG_OCR_ENABLED=true
RAG_OCR_LANGUAGES=eng+vie
RAG_OCR_DPI=200
# RAG_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# RAG_TESSDATA_DIR=./data/tessdata     # non-admin language-pack location
RAG_MAX_VISUALS_PER_DOCUMENT=20
# Split high-confidence 2x3 PDF handouts so OCR/vision sees each slide clearly.
RAG_PDF_SPLIT_HANDOUTS=true

# Optional semantic descriptions for charts/diagrams. This can send images to
# the configured provider, so it is deliberately opt-in for data residency and
# cost reasons. Local OCR continues to run when this is false.
RAG_VISION_ENABLED=false
# RAG_VISION_PROVIDER=anthropic       # anthropic | openai
# RAG_VISION_MODEL=                   # defaults to RAG_LLM_MODEL
# RAG_VISION_API_KEY_ENV=             # defaults by provider
# RAG_VISION_BASE_URL=                # optional OpenAI-compatible gateway

# Durable chat history + long-term memory. Docker Compose supplies this URL
# automatically; direct local runs fall back to ./data/chat_history.db.
# RAG_DATABASE_URL=postgresql+psycopg://fpt_rag:change-me@localhost:5432/fpt_rag
RAG_AUTO_MIGRATE=true               # local convenience; Compose runs Alembic explicitly
POSTGRES_DB=fpt_rag
POSTGRES_USER=fpt_rag
POSTGRES_PASSWORD=fpt_rag_local_change_me  # change outside local development

# ============================================================================
# BACKENDS (auto = pick the real one, fall back if unavailable)
# ============================================================================
RAG_EMBEDDER_BACKEND=auto           # auto | sentence_transformers | flag | openai | hash
RAG_VECTORSTORE_BACKEND=auto        # auto | chroma | memory
RAG_RERANKER_BACKEND=auto           # auto | sentence_transformers | flag | lexical

# ============================================================================
# EMBEDDINGS / RERANKER (local BGE-M3)
# ============================================================================
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIM=1024              # 1024 for BGE-M3; match your API model if using openai backend
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_DEVICE=auto                     # auto | cpu | cuda

# --- OpenAI-compatible embeddings (VDI) ---
# RAG_EMBEDDING_API_BASE_URL=
RAG_EMBEDDING_API_MODEL=text-embedding-3-small
RAG_EMBEDDING_API_KEY_ENV=OPENAI_API_KEY

# ============================================================================
# LLM GENERATION (provider is pluggable)
# ============================================================================
RAG_LLM_PROVIDER=anthropic          # anthropic | openai | claude_cli | codex_cli | extractive
RAG_LLM_MODEL=claude-opus-4-8       # e.g. gpt-4o-mini for the openai provider
# RAG_LLM_BASE_URL=                 # set for aiportalapi / Azure / other gateway
# RAG_LLM_API_KEY_ENV=              # defaults: anthropic->ANTHROPIC_API_KEY, openai->OPENAI_API_KEY
# claude_cli: demo-only, shells out to the local `claude` CLI (its claude.ai
# login), no API key. Optional RAG_CLAUDE_CLI_BIN points at the claude binary.
RAG_LLM_MAX_TOKENS=1024
RAG_LLM_TEMPERATURE=0.0
RAG_LLM_REASONING_EFFORT=auto       # codex_cli: provider default; or low/medium/high
RAG_ALLOW_EXTRACTIVE_FALLBACK=true  # answer via extractive fallback when no LLM key is set

# API keys (set the one your provider needs)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ============================================================================
# CACHE + SESSION MEMORY (serverless by default — no Redis)
# ============================================================================
RAG_CACHE_BACKEND=memory        # memory (in-process TTL+LRU) | redis | off
RAG_CACHE_MAX_ENTRIES=2048      # LRU cap for the in-process cache
RAG_MEMORY_BACKEND=sqlite       # sqlite (durable, in /data) | redis | inprocess
# Optional Redis backend (only if the enterprise approves it):
# RAG_REDIS_URL=redis://localhost:6379/0
# RAG_REDIS_REQUIRED=false

# ============================================================================
# RETRIEVAL / ABSTENTION (tune against the golden set later)
# ============================================================================
RAG_DENSE_TOP_K=20
RAG_BM25_TOP_K=20
RAG_RRF_K=60
RAG_RERANK_TOP_N=5
RAG_RERANK_THRESHOLD_MEDIUM=0.50
RAG_DEFAULT_LANGUAGE=en
RAG_LANG_CONFIDENCE_GATE=0.85

# ============================================================================
# API SERVICE
# ============================================================================
RAG_CORS_ORIGINS=*                  # comma-separated origins for the frontend
